{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heimdall",
  "version": "0.1.0",
  "identifier": "com.heimdall.desktop",
  "build": {
    "frontendDist": "../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix client run dev",
    "beforeBuildCommand": "npm --prefix client run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Heimdall",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
